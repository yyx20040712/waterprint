== #"4.4 旋流沉砂池（municipal_chenshachi）"

#"设计工况（design）主要尺寸与负荷："

$ q 1 = frac(q_(d e s i g n), n) $

#"（公式 CS-F1——条文出处：GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"单池流量：0.2816260417 m3/s〔CS-F1〕"

$ h 2 = frac(q_(s u r f) t_(r e t e n t i o n), 3600) $

#"（公式 CS-F3——条文出处：中期报告 §3.3 式(3-22)（毕业设计内部资料，待核对映射条文）；GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"有效水深：1.25 m〔CS-F3〕"

$ r a t i o_(d h 2) = frac(d, h 2) $

#"（公式 CS-F4——条文出处：GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"径深比：2.4〔CS-F4〕"

$ v_(e f f) = frac(h 2 p i d^2, 4) $

#"（公式 CS-F5——条文出处：GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"单池有效容积：8.8357293382 m3〔CS-F5〕"

$ t_(a c t u a l) = frac(v_(e f f), q 1) $

#"（公式 CS-F6——条文出处：GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"实际停留时间：31.3739783648 s〔CS-F6〕"

$ v_(s a n d) = frac(54 q_(a v g   d a i l y) x_(s a n d), 625 n) $

#"（公式 CS-F7——条文出处：中期报告 §3.3 式(3-24)（毕业设计内部资料，待核对映射条文）；GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"单池日沉砂量：0.5214105 m3〔CS-F7〕"

$ v_(h o p p e r) = s a f e t y t_(c l e a n) v_(s a n d) $

#"（公式 CS-F8——条文出处：中期报告 §3.3 式(3-25)（毕业设计内部资料，待核对映射条文）；GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"砂斗容积：1.5642315 m3〔CS-F8〕"

$ d_(u p p e r) = d u p p e r_(r a t i o) $

#"（公式 CS-F9——条文出处：GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"砂斗上口直径：1.5 m〔CS-F9〕"

$ h 4 = frac(- d_(r) - d_(u p p e r), 2 t a n_(t h e t a)) $

#"（公式 CS-F10——条文出处：中期报告 §3.3 式(3-27)（毕业设计内部资料，待核对映射条文）；GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"砂斗高度：0.3501037691 m〔CS-F10〕"

$ v_(c o n e) = frac(h 4 p i (d_(r))^2 + d_(r) d_(u p p e r) + (d_(u p p e r))^2, 12) $

#"（公式 CS-F11——条文出处：GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"砂斗圆台容积：0.2978850954 m3〔CS-F11〕"

$ h_(c h a n n e l) = frac(q 1, b_(c h a n n e l) v_(c h a n n e l)) $

#"（公式 CS-F14——条文出处：中期报告 §3.3 式(4-26)~(4-27)（毕业设计内部资料，待核对映射条文）；GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"进水渠水深：0.3520325521 m〔CS-F14〕"

$ l_(s t r a i g h t) = max(s t r a i g h t_(m i n), b_(c h a n n e l) s t r a i g h t_(m u l t)) $

#"（公式 CS-F15——条文出处：中期报告 §3.3 式(4-28)（毕业设计内部资料，待核对映射条文）；GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"进水渠直段长：5.6 m〔CS-F15〕"

$ b_(o u t l e t) = b_(c h a n n e l) o u t l e t_(m u l t) $

#"（公式 CS-F16——条文出处：中期报告 §3.3 式(4-29)（毕业设计内部资料，待核对映射条文）；GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"出水渠宽：1.6 m〔CS-F16〕"

$ d s_(g r i t) = g r i t_(d e n s i t y) n v_(s a n d) 1 - m o i s t u r e $

#"（公式 CS-F17——条文出处：GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"日干砂量（全池）：667.40544 kg〔CS-F17〕"

$ v_(c o n c r e t e) = frac(h_(t o t a l) n p i w a l l_(c o e f) d^2, 4) $

#"（公式 CS-F18——条文出处：GB 50014-2021 §6.4（条文号待核对原文；docs/norms/chenshachi.md 签字表 2026-08-23））"

- #"池体混凝土量（概算）：18.6610603623 m3〔CS-F18〕"

- #"a_channel：0.2816260417〔CS-F1〕"

- #"d：3.0"

