== #"4.3 细格栅（municipal_xigeshan）"

#"设计工况（design）主要尺寸与负荷："

$ q = frac(q_(d e s i g n), n) $

#"（公式 XG-F1——条文出处：GB 50014-2021 §6.3（条文号待核对原文；docs/norms/xigeshan.md 签字表 2026-08-23））"

- #"单台流量：0.1877506944 m3/s〔XG-F1〕"

$ v_(c h e c k e d) = frac(q s q r t_(s i n   a l p h a), b h n_(g a p)) $

#"（公式 XG-F5——条文出处：GB 50014-2021 §6.3（条文号待核对原文；docs/norms/xigeshan.md 签字表 2026-08-23））"

- #"校核过栅流速：0.7899361437 m/s〔XG-F5〕"

$ v 1_(c h e c k e d) = frac(q, b 1 h) $

#"（公式 XG-F6——条文出处：GB 50014-2021 §6.3（条文号待核对原文；docs/norms/xigeshan.md 签字表 2026-08-23））"

- #"校核栅前流速：0.6258356481 m/s〔XG-F6〕"

$ x i = b e t a (s_(o v e r   b))^(frac(4, 3)) $

#"（公式 XG-F7——条文出处：GB 50014-2021 §6.3（条文号待核对原文；docs/norms/xigeshan.md 签字表 2026-08-23））"

- #"栅条阻力系数 ξ：0.6544207425〔XG-F7〕"

$ h 1 = frac(k_(h e a d l o s s) s i n_(a l p h a) x i (v_(c h e c k e d))^2, 2 g) $

#"（公式 XG-F8——条文出处：GB 50014-2021 §6.3（条文号待核对原文；docs/norms/xigeshan.md 签字表 2026-08-23））"

- #"过栅水头损失：0.0586744592 m〔XG-F8〕"

$ w_(s l a g) = frac(432 q_(d e s i g n) w 1, 5 k z) $

#"（公式 XG-F11——条文出处：GB 50014-2021 §6.3（条文号待核对原文；docs/norms/xigeshan.md 签字表 2026-08-23））"

- #"日栅渣量：2.780856 m3〔XG-F11〕"

$ d s_(s l a g) = 1000 w_(s l a g) 1 - m o i s t u r e $

#"（公式 XG-F13——条文出处：GB 50014-2021 §6.3（条文号待核对原文；docs/norms/xigeshan.md 签字表 2026-08-23））"

- #"日干栅渣量：556.1712 kg〔XG-F13〕"

$ v_(c o n c r e t e) = B H L n w a l l_(c o e f) $

#"（公式 XG-F14——条文出处：GB 50014-2021 §6.3（条文号待核对原文；docs/norms/xigeshan.md 签字表 2026-08-23））"

