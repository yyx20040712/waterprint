  "info": {
    "title": "WaterPrint 服务层",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/assumptions": {
      "get": {
        "description": "设计假设清单（21 条 registry 声明序——六字段取五，D2/D6）。",
        "operationId": "list_assumptions_api_assumptions_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssumptionCatalog"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Assumptions",
        "tags": [
          "units"
        ]
      }
    },
    "/api/calc/enumerate": {
      "post": {
        "description": "单单元枚举（ADR-005 语义守护在服务面）。",
        "operationId": "run_enumeration_api_calc_enumerate_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnumerateRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskIdResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Run Enumeration",
        "tags": [
          "calc"
        ]
      }
    },
    "/api/calc/run": {
      "post": {
