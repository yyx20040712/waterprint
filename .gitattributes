# 统一换行与文本判定；全部文本文件 UTF-8（无 BOM）
* text=auto

*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.dxf text eol=lf
*.html text eol=lf
*.css text eol=lf

# 二进制
*.png binary
*.jpg binary
*.xlsx binary
*.dwg binary
